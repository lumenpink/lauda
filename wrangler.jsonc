{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lauda",
  "main": "worker/index.js",
  "compatibility_date": "2024-09-23",
  "routes": [
    {
      "pattern": "lauda.2lp.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "LAUDA_BUCKET",
      "bucket_name": "lauda-downloads"
    }
  ]
}
